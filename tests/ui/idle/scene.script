# Idle check scene: the app with everything it can show so far, then no `quit`, so it
# goes idle. The screenshot at the end is the harness's "ready" signal.
grid 4
key Shift+W
viewdir 2 Back
viewdir 3 Left
camera 0 60 30 300 10 20 0
addbox 0 0 0 64 48 32
addbox 96 0 0 128 32 96
testimage ref.png 64 32
refload 1 ref.png
testimage back.png 32 64
refload 2 back.png
refset 2 front 1
action view.scalefigure
action help.controls
action view.paintwindow
wait 4
expect paintwindow 1
expect grid 4
expect snap 0
expect controls 1
expect faces 12
expect selected 6
expect refimage 1 1
expect refimage 2 1
expect figure 1
# A live preview waiting for Return (Extrude, armed) must not keep drawing either.
key 3
key Shift+E
wait 2
expect armed 1
wait 3
shot idle-ready.png
