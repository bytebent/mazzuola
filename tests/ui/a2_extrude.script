# Alpha 2, v0.2.0: extrude and inset (ARCHITECTURE §6, agreed 2026-11-20).
# Views: 0 3D, 1 Top (x right, y up), 2 Front (x right, z up), 3 Right. Grid 8, snap on.
vworld 2 0 0 0
wheel -3
vworld 1 0 0 0
wheel -4
wait 2
addbox 0 0 0 64 48 32
expect faces 6

# ---- Points: since v0.2.6 they bevel (the tool switches to Bevel); Esc drops it
key 1
key Shift+E
expect tool Extrude
expect armed 1
expect bevelling 1
key Esc
wait 1
expect armed 0
# Face mode: click the top face in the Top view; the preview comes up at once
key 3
vworld 1 32 24 0
wait 2
press left
wait 1
release left
wait 2
expect armed 1
expect selected 1
# Default 16 cm along the normal: a preview, no undo step yet
expect bounds 0 0 0 64 48 48
expect undo 1
# Drag the arrow (Front view) up 8 more
vworld 2 32 0 50
wait 2
press left
wait 1
vworld 2 32 0 54
wait 1
vworld 2 32 0 58
wait 1
release left
wait 1
expect bounds 0 0 0 64 48 56
key Return
wait 1
expect armed 0
expect undo 2
expect faces 10
expect selected 1
expect selbounds 0 0 56 64 48 56

# ---- The new end face is selected: change a setting and extrude again, straight on X
toolset extrude straight 1
toolset extrude axis 0
toolset extrude distance 8
expect armed 1
expect opvalid 0
# (straight along X from a face lying in X: nothing sensible, red, Return does nothing)
key Return
expect undo 2
toolset extrude axis 2
expect opvalid 1
key Esc
expect armed 0
expect bounds 0 0 0 64 48 56
toolset extrude straight 0

# ---- Inset the top: 8 cm frame, 4 cm deep (straight walls, flat frame)
key Shift+I
expect tool Inset
toolset inset width 8
toolset inset depth 4
expect armed 1
expect opvalid 1
expect selbounds 8 8 52 56 40 52
wait 2
shot a2-inset.png
key Return
wait 1
expect undo 3
expect faces 18
expect selected 1
# After Return, a new width waits for faces to be clicked (no inset inside the inset)
toolset inset depth 0
toolset inset width 30
expect armed 0
expect faces 18
expect undo 3
vworld 1 32 24 0
wait 2
press left
wait 1
release left
wait 2
expect armed 1
# Too wide: red, Return does nothing
expect opvalid 0
key Return
expect undo 3
key Esc

# ---- Open edges: a flat face's far edge extruded straight up
addquad 100 0 164 48 0
key 2
key Shift+E
vworld 1 132 48 0
wait 2
press left
wait 1
release left
wait 2
expect selected 1
expect armed 1
toolset extrude distance 24
expect selbounds 100 48 24 164 48 24
key Return
wait 1
expect faces 20
expect undo 5

# ---- Keep original: a flat face becomes a solid
key 3
addquad 200 0 264 48 0
key 3
vworld 1 232 24 0
wait 2
press left
wait 1
release left
wait 2
toolset extrude keep 1
toolset extrude distance 16
key Return
wait 1
expect faces 26
expect undo 7
wait 2
shot a2-extrude.png
quit
