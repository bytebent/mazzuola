# Alpha 1, v0.1.3: typed values (ARCHITECTURE §6 Transform, Multi-Replicate, Duplicate,
# Mirror, Flatten). Operation windows stay open with a live preview; Return applies as
# one undo step, Esc cancels.
vworld 1 0 0 0
wheel -3
wait 2
addbox 8 0 0 40 32 32
expect undo 1

# ---- Transform: a quarter turn about its centre and 8 cm along x; preview, then Return
key Cmd+T
expect op transform
opset rotate 0 0 90
opset move 8 0 0
wait 2
expect bounds 16 0 0 48 32 32
expect undo 1
shot m1-09-transform.png
key Return
expect op none
expect undo 2
expect bounds 16 0 0 48 32 32

# ---- Esc puts everything back, no undo step
key Cmd+T
opset move 100 0 0
opset rotate 0 0 0
expect bounds 116 0 0 148 32 32
key Esc
expect op none
expect bounds 16 0 0 48 32 32
expect undo 2

# ---- along the normal: the top face up 8 (the window opens at zero again)
key 3
vworld 1 32 16 0
press left
wait 1
release left
wait 1
expect selected 1
key Cmd+T
opset normal 8
key Return
expect bounds 16 0 0 48 32 40
key Cmd+Z
expect bounds 16 0 0 48 32 32
key 4

# ---- Multi-Replicate: a row of 3 copies 48 apart; the copies end up selected
action edit.selectall
key Cmd+Shift+D
expect op replicate
opset copies 3
opset offset 48 0 0
wait 2
expect faces 24
expect selected 18
key Return
expect undo 3
expect bounds 16 0 0 192 32 32
key Cmd+Z
expect faces 6

# ---- a circle: 3 copies turned 90° about the world origin, no offset
action edit.selectall
key Cmd+Shift+D
opset copies 3
opset offset 0 0 0
opset turn 0 0 90
opset copypivot origin
key Return
expect faces 24
expect bounds -48 -48 0 48 48 32
key Cmd+Z

# ---- mirror clone across x = 0 (the copy is selected), mirror in place, duplicate
action edit.selectall
action mesh.mirrorclonex
expect faces 12
expect selected 6
expect selbounds -48 0 0 -16 32 32
action mesh.mirrory
expect selbounds -48 0 0 -16 32 32
key Cmd+D
expect faces 18
expect selected 6
expect selbounds -48 0 0 -16 32 32

# ---- flatten the duplicate's points onto their lowest z
key 1
expect selected 8
action mesh.flatten
expect op flatten
opset axis 2
opset to lowest
key Return
expect selbounds -48 0 0 -16 32 0

# ---- snap to grid (Cmd+B)
addbox 0.5 60.25 0 15.5 75 9
key Cmd+B
expect selbounds 0 64 0 16 72 8

# ---- the Vertex tool works on points only: 3 (faces) switches to Select
key Shift+V
expect tool Vertex
expect mode vertices
key 3
expect tool Select
expect mode faces
quit
