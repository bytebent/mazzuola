# Milestone 1: primitives, selecting, moving / scaling / rotating with handles, typed
# dialogs, hide / show, duplicate, delete, undo, save / open, export, reference images.
# Views: 0 Top, 1 Front, 2 Right, 3 3D. Grid 8 cm, snap on.
wait 3

# ---- draw a box in the Top view (Primitives tool), create it with Return
key Shift+B
expect tool Primitives
vworld 0 -30 -30 0
press left
wait 2
vworld 0 0 0 0
wait 2
vworld 0 31 33 0
wait 2
release left
wait 2
expect preview 1
key Return
wait 2
expect preview 0
expect faces 6
expect tris 12
expect selected 6
expect bounds -32 -32 0 32 32 64
expect dirty 1
shot m1-01-box.png

# ---- move it with a drag in the Front view (x right, z up), then undo / redo
key Shift+S
expect tool Select
vworld 1 0 0 32
press left
wait 2
vworld 1 8 0 40
wait 2
vworld 1 15 0 47
wait 2
release left
wait 2
expect bounds -16 -32 16 48 32 80
key Cmd+Z
wait 1
expect bounds -32 -32 0 32 32 64
key Cmd+Shift+Z
wait 1
expect bounds -16 -32 16 48 32 80

# ---- a click on the selection switches to rotate handles, another back to scale
vworld 1 16 0 48
press left
wait 1
release left
wait 2
expect handles rotate
press left
wait 1
release left
wait 2
expect handles scale

# ---- scale with the right-middle handle (6 px outside the box): 64 -> 96 cm wide
vworld 1 48 0 48
nudge 6 0
press left
wait 2
vworld 1 64 0 48
nudge 6 0
wait 2
vworld 1 80 0 48
nudge 6 0
wait 2
release left
wait 2
expect bounds -16 -32 16 80 32 80
key Cmd+Z
wait 1
expect bounds -16 -32 16 48 32 80

# ---- Esc during a drag puts things back
vworld 1 16 0 48
press left
wait 2
vworld 1 40 0 48
wait 2
key Esc
wait 2
release left
wait 2
expect bounds -16 -32 16 48 32 80

# ---- typed transform: two copies 100 cm apart along X
transform copies 2
transform move 100 0 0
transform apply
wait 1
expect faces 18
expect selected 12
expect bounds -16 -32 16 248 32 80
key Cmd+Z
wait 1
expect faces 6
transform reset

# ---- typed transform: turn 90 degrees around Z (around the selection centre)
transform rotate 0 0 90
transform apply
wait 1
expect bounds -16 -32 16 48 32 80
transform reset

# ---- mirrored copy across the model pivot (the origin) along X
mirror 0 1
wait 1
expect faces 12
expect bounds -48 -32 16 48 32 80
shot m1-02-mirror.png

# ---- hide, show all, duplicate, delete
key Cmd+A
expect selected 12
key H
wait 1
expect hidden 12
key Cmd+U
wait 1
expect hidden 0
key Cmd+A
key Cmd+D
wait 1
expect faces 24
key Delete
wait 1
expect faces 12
key Cmd+A
key Delete
wait 1
expect faces 0
key Cmd+Z
wait 1
expect faces 12

# ---- vertices: box select the top points in the Front view and flatten them down
key 1
expect mode vertices
vworld 1 -60 0 74
press left
wait 2
vworld 1 0 0 90
wait 2
vworld 1 60 0 90
wait 2
release left
wait 2
expect selected 8
flatten 2 3 16
wait 1
expect bounds -48 -32 16 48 32 16
key Cmd+Z
wait 1
key 3
expect mode faces

# ---- model pivot by clicking in the Top view
dialog pivotplace
wait 2
vworld 0 0 32 0
press left
wait 1
release left
wait 2
expect pivot 0 32 0

# ---- files: save, new, open, export
saveas model.mazz
expect dirty 0
new
expect faces 0
open model.mazz
expect faces 12
expect pivot 0 32 0
expect dirty 0
export model.glb
export model.gltf
export model.obj

# ---- reference image, scale figure, a rock
ref Front @/data/ref_front.png 120
expect refs 1
action view.figure
prim rock
primset seed 7
primset size 60 50 40
primset centre 0 -90 20
wait 2
key Return
wait 2
expect preview 0
action view.frame
wait 3
shot m1-03-rock-refs-figure.png
key Cmd+Z
expect faces 12
action view.figure
quit
