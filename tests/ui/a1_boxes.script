# Alpha 1, v0.1.0: making boxes and handling them like brushes (ARCHITECTURE §6).
# Views: 0 3D, 1 Top (x right, y up), 2 Front (x right, z up), 3 Right. Grid 8, snap on.

# ---- draw a box in Top: 0..64 x 0..48; depth from the default last box (z 0..64)
# zoom the Top view out a little so everything below stays in view
vworld 1 0 0 0
wheel -3
wait 2
key Shift+B
expect tool Primitives
vworld 1 0 0 0
press left
wait 1
vworld 1 30 20 0
wait 1
vworld 1 63 49 0
wait 1
release left
wait 1
expect preview 1
expect faces 0
# ---- the height is visible in Front: pull its top handle down to z 32
vworld 2 32 0 64
press left
wait 1
vworld 2 32 0 50
wait 1
vworld 2 32 0 33
wait 1
release left
wait 1
key Return
wait 1
expect preview 0
expect faces 6
expect selected 6
expect bounds 0 0 0 64 48 32
expect undo 1
shot m1-03-box-made.png

# ---- Esc drops a preview
vworld 1 -100 -100 0
press left
wait 1
vworld 1 -60 -60 0
wait 1
release left
wait 1
expect preview 1
key Esc
expect preview 0
expect faces 6

# ---- select: empty click, click on the box
key Shift+S
expect tool Select
vworld 1 -100 60 0
press left
wait 1
release left
wait 1
expect selected 0
vworld 1 10 10 0
press left
wait 1
release left
wait 1
expect selected 6

# ---- move by dragging inside (snapped), undo
press left
wait 1
vworld 1 20 10 0
wait 1
vworld 1 26 11 0
wait 1
release left
wait 1
expect bounds 16 0 0 80 48 32
expect undo 2
key Cmd+Z
expect bounds 0 0 0 64 48 32
expect selected 6

# ---- Shift+drag copies; the copy is selected
vworld 1 10 10 0
hold shift
press left
wait 1
vworld 1 10 -30 0
wait 1
vworld 1 10 -70 0
wait 1
release left
letgo shift
wait 1
expect faces 12
expect selected 6
expect selbounds 0 -80 0 64 -32 32

# ---- rectangle from empty space selects both; Cmd+click removes the copy
vworld 1 -20 80 0
press left
wait 1
vworld 1 40 0 0
wait 1
vworld 1 100 -100 0
wait 1
release left
wait 1
expect selected 12
vworld 1 10 -50 0
hold cmd
press left
wait 1
release left
letgo cmd
wait 1
expect selected 6
expect selbounds 0 0 0 64 48 32

# ---- resize: the right side handle pushed from x 64 to x 96; the left side stays
vworld 1 64 24 0
press left
wait 1
vworld 1 80 24 0
wait 1
vworld 1 95 25 0
wait 1
release left
wait 1
expect selbounds 0 0 0 96 48 32

# ---- Option+drag the top-right corner: a quarter turn about the centre (48, 24)
vworld 1 96 48 0
hold alt
press left
wait 1
vworld 1 70 80 0
wait 1
vworld 1 24 72 0
wait 1
release left
letgo alt
wait 1
expect selbounds 24 -24 0 72 72 32

# ---- the Z ring in the 3D view: another quarter turn (back to 0..96 x 0..48)
camera 0 30 50 400 48 24 16
wait 2
# a point on the Z ring at 45 degrees (radius = half the box diagonal x 1.15 = 64.4),
# dragged round to 135 degrees
vworld 0 93.538 69.538 16
press left
wait 1
vworld 0 48.000 88.400 16
wait 1
vworld 0 2.462 69.538 16
wait 1
release left
wait 1
expect selbounds 0 0 0 96 48 32
shot m1-04-handles.png

# ---- moving snaps the box's lowest corner onto the grid (as in Scalpellino)
addbox -77 30 0 -61 46 16
expect selbounds -77 30 0 -61 46 16
vworld 1 -70 38 0
press left
wait 1
vworld 1 -60 38 0
wait 1
vworld 1 -59 38 0
wait 1
release left
wait 1
expect selbounds -64 32 0 -48 48 16
key Cmd+Z
expect selbounds -77 30 0 -61 46 16
key Cmd+Z
expect faces 12
vworld 1 48 24 0
press left
wait 1
release left
wait 1
expect selbounds 0 0 0 96 48 32

# ---- delete, undo, Esc
key Delete
expect faces 6
expect selected 0
key Cmd+Z
expect faces 12
expect selected 6
key Esc
expect selected 0
# The saved file stays clean after moves, resizes and quarter turns.
saveas boxes
expect fileline boxes.mazz v 96 48 32
expect fileline boxes.mazz v 0 -80 0
quit
