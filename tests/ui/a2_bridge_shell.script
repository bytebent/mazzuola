# Alpha 2, v0.2.6: Mesh -> Bridge... and Shell... (ARCHITECTURE §6, agreed 2026-11-22).
# Views: 0 3D, 1 Top (x right, y up), 2 Front (x right, z up), 3 Right. Grid 8, snap on.
vworld 2 0 0 0
wheel -3
vworld 1 0 0 0
wheel -3
wait 2
addbox 0 0 0 32 32 32
addbox 64 0 0 96 32 32
vworld 0 48 16 16
wheel 5
wait 2

# ---- Bridge two faces: the boxes' facing sides (a rectangle round the gap in the Top
# view picks the faces whose middles are inside it)
key 3
vworld 1 28 -8 0
press left
wait 1
vworld 1 48 20 0
wait 1
vworld 1 68 40 0
wait 1
release left
wait 1
expect selected 2
action mesh.bridge
wait 1
expect op bridge
expect opvalid 1
# 12 faces, less the 2, plus a tube of 4
expect faces 14
expect selected 4
opset segments 3
expect faces 22
opset twist 1
expect opvalid 1
opset twist 0
key Return
wait 1
expect op none
expect closed 1
expect faces 22
expect bounds 0 0 0 96 32 32
wait 2
shot a2-bridge.png
action edit.undo
wait 1

# ---- Bridge two holes: tear the two sides open, then edge mode (an edge on each)
key 3
vworld 1 28 -8 0
press left
wait 1
vworld 1 68 40 0
wait 1
release left
wait 1
action mesh.tearopen
wait 1
expect closed 0
expect faces 10
# Nothing is selected after tearing open: edge mode, the same rectangle picks the
# holes' edges
key 2
vworld 1 28 -8 0
press left
wait 1
vworld 1 68 40 0
wait 1
release left
wait 1
expect selected 8
action mesh.bridge
wait 1
expect op bridge
opset segments 1
expect opvalid 1
key Return
wait 1
expect closed 1
expect faces 14

# ---- Shell: a box without a top gets walls 4 thick (inward, then outward)
action file.new
wait 1
addbox 0 0 0 32 32 32
key 3
vworld 1 16 16 32
wait 1
press left
release left
wait 1
expect selected 1
action mesh.tearopen
wait 1
expect closed 0
action edit.selectall
action mesh.shell
wait 1
expect op shell
opset thickness 4
expect opvalid 1
# 5 walls, 5 inside, 4 rim
expect faces 14
expect closed 1
expect bounds 0 0 0 32 32 32
opset side outward
expect bounds -4 -4 -4 36 36 32
opset side inward
key Return
wait 1
expect closed 1
expect verts 16
wait 2
shot a2-shell.png

# ---- Shell on a closed box: can't, says why; Return does nothing
action file.new
wait 1
addbox 0 0 0 32 32 32
action mesh.shell
wait 1
expect opvalid 0
key Return
wait 1
expect op shell
expect faces 6
key Esc
wait 1
expect op none
quit
