# Alpha 2, v0.2.6: Bevel in the Extrude tool (ARCHITECTURE §6 Bevel, agreed 2026-11-22).
# Views: 0 3D, 1 Top (x right, y up), 2 Front (x right, z up), 3 Right. Grid 8, snap on.
vworld 2 0 0 0
wheel -3
vworld 1 0 0 0
wheel -3
wait 2
addbox 0 0 0 64 48 48
vworld 0 32 24 24
wheel 6
wait 2

# ---- One edge (edge mode, picked in 3D): the tool switches to Bevel by itself
key 2
key Shift+E
vworld 0 32 0 48
wait 2
press left
release left
wait 2
expect selected 1
expect armed 1
expect bevelling 1
expect opvalid 1
# Default width 4: the two end caps lose a corner (split in two), plus the strip
expect faces 9
expect undo 1
# Drag the arrow (Front view) 4 further into the box: width 8
vworld 2 32 0 45.172
wait 2
press left
wait 1
vworld 2 32 0 43.7
wait 1
vworld 2 32 0 42.343
wait 1
release left
wait 1
expect selbounds 0 0 40 64 8 48
# Two segments round it; too wide turns it red; back to one
toolset extrude segments 2
expect opvalid 1
expect faces 10
toolset extrude width 60
expect opvalid 0
toolset extrude width 8
toolset extrude segments 1
expect opvalid 1
key Return
wait 1
expect armed 0
expect undo 2
expect closed 1
expect faces 9
expect verts 10
expect selected 1
wait 2
shot a2-bevel-edge.png
action edit.undo
wait 1
# Undo brings the edge back and the preview with it; Esc drops the preview
expect armed 1
key Esc
wait 1

# ---- Every edge (a rectangle round the box in the Front view; Cmd+A would pick the
# piece), 2 segments: rounded all round, still closed
key 2
vworld 2 -16 0 64
wait 1
press left
wait 1
vworld 2 30 0 20
wait 1
vworld 2 80 0 -16
wait 1
release left
wait 1
# the preview at once: 12 strips and 8 corner triangles selected
expect selected 20
expect bevelling 1
toolset extrude width 8
toolset extrude segments 2
expect opvalid 1
key Return
wait 1
expect closed 1
expect undo 2
wait 2
shot a2-bevel-all.png
action edit.undo
wait 1
key Esc
wait 1

# ---- Points: every corner cut off
key 1
vworld 2 -16 0 64
wait 1
press left
wait 1
vworld 2 30 0 20
wait 1
vworld 2 80 0 -16
wait 1
release left
wait 1
# the preview: 8 corner faces
expect selected 8
expect bevelling 1
toolset extrude width 8
key Return
wait 1
expect closed 1
expect verts 24
action edit.undo
wait 1
key Esc
wait 1

# ---- Faces: Extrude; Bevel can't be chosen
key 3
vworld 1 32 24 48
wait 2
press left
release left
wait 1
expect selected 1
expect bevelling 0
toolset extrude bevel 1
expect bevelling 0
key Esc
quit
