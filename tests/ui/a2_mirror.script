# Alpha 2, v0.2.7: mirror mode (ARCHITECTURE §6 Mirror mode, agreed 2026-11-22).
# Views: 0 3D, 1 Top (x right, y up), 2 Front (x right, z up), 3 Right. Grid 8, snap on.
vworld 2 0 0 0
wheel -3
vworld 1 0 0 0
wheel -3
wait 2
addbox -32 0 0 32 32 32
vworld 0 0 16 16
wheel 4
wait 2

# ---- On (plane X): picking the +X side picks its twin too
key Shift+M
wait 1
expect mirror 0
expect unpaired 0
key 3
action edit.selectnone
vworld 0 32 8 16
wait 2
press left
release left
wait 1
expect selected 2

# ---- Push/pull the +X side out 8 (Top view, the side seen edge-on): -X goes out too
key Shift+F
vworld 1 32 16 32
wait 2
press left
wait 1
vworld 1 36 16 32
wait 1
vworld 1 40 16 32
wait 1
release left
wait 1
key Return
wait 1
expect bounds -40 0 0 40 32 32
expect closed 1
expect unpaired 0

# ---- The Vertex tool: a top corner on +X dragged out and up (Front view); its twin
# goes the mirrored way
key Shift+V
key 1
action edit.selectnone
vworld 2 40 0 32
wait 2
press left
wait 1
vworld 2 44 0 36
wait 1
vworld 2 48 0 40
wait 1
release left
wait 1
expect bounds -48 0 0 48 32 40
expect unpaired 0
wait 2
shot a2-mirror.png
action edit.undo
action edit.undo
wait 1
expect bounds -32 0 0 32 32 32

# ---- Move / rotate / scale: the +X face moved 8 along X; the -X face goes -8
key Shift+S
key 3
action edit.selectnone
vworld 0 32 8 16
wait 2
press left
release left
wait 1
expect selected 2
action mesh.transform
wait 1
expect op transform
opset move 8 0 0
key Return
wait 1
expect bounds -40 0 0 40 32 32
action edit.undo
wait 1

# ---- A box only on +X: its 8 points have no twin; Make symmetric copies it across
addbox 48 0 0 64 16 16
wait 1
expect unpaired 8
action mesh.symmetric
wait 1
expect op symmetric
opset keep 1
expect opvalid 1
key Return
wait 1
expect unpaired 0
expect bounds -64 0 0 64 32 32
expect closed 1

# ---- A box off centre: keep +X (-48..48), or -X (-16..16)
action file.new
wait 1
addbox -16 0 0 48 32 32
expect unpaired 8
action mesh.symmetric
wait 1
opset plane 0
opset keep 1
expect bounds -48 0 0 48 32 32
opset keep -1
expect bounds -16 0 0 16 32 32
key Return
wait 1
expect closed 1
expect unpaired 0

# ---- Off again: single selection
key Shift+M
wait 1
expect mirror -1
key 3
vworld 0 16 8 16
wait 2
press left
release left
wait 1
expect selected 1
quit
