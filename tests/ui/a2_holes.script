# Alpha 2, v0.2.3: holes and outlines (ARCHITECTURE §6 Draw, agreed 2026-11-20).
# Views: 0 3D, 1 Top (x right, y up), 2 Front (x right, z up), 3 Right. Grid 8, snap on.
vworld 1 0 0 0
wheel -3
vworld 2 0 0 0
wheel -3
wait 2

# ---- A wall 160 x 16 x 96; a window drawn on the front
addbox 0 0 0 160 16 96
key 3
key Shift+D
toolset draw shape 0
vworld 2 32 0 40
wait 2
press left
release left
vworld 2 64 0 72
wait 2
press left
release left
wait 1
key Return
wait 1
expect undo 2
expect selected 1

# ---- Pushed in past the back (Top view: the window's edge-on line): a hole, it stops at 16
key Shift+F
vworld 1 48 0 56
wait 2
press left
wait 1
vworld 1 48 8 56
wait 1
vworld 1 48 40 56
wait 1
release left
wait 1
expect pushdist -16
expect opvalid 1
key Return
wait 1
expect undo 3
expect bounds 0 0 0 160 16 96

# ---- A doorway from the floor, through
key Shift+D
vworld 2 96 0 0
wait 2
press left
release left
vworld 2 128 0 64
wait 2
press left
release left
wait 1
key Return
wait 1
key Shift+F
vworld 1 112 0 30
wait 2
press left
wait 1
vworld 1 112 16 30
wait 1
vworld 1 112 32 30
wait 1
release left
wait 1
expect pushdist -16
key Return
wait 1
expect undo 5

# ---- Outline in the Top view, with a hole; Return makes it; Push/pull makes it solid
key Shift+D
toolset draw shape 3
toolset draw twosided 0
vworld 1 0 -120 0
wait 2
press left
release left
vworld 1 96 -120 0
wait 2
press left
release left
vworld 1 96 -56 0
wait 2
press left
release left
vworld 1 48 -24 0
wait 2
press left
release left
vworld 1 0 -56 0
wait 2
press left
release left
vworld 1 0 -120 0
wait 2
press left
release left
wait 1
expect fits 1
# a square hole
vworld 1 32 -96 0
wait 2
press left
release left
vworld 1 64 -96 0
wait 2
press left
release left
vworld 1 64 -72 0
wait 2
press left
release left
vworld 1 32 -72 0
wait 2
press left
release left
vworld 1 32 -96 0
wait 2
press left
release left
wait 1
expect fits 1
key Return
wait 1
expect undo 6
expect drawing 0
expect selbounds 0 -120 0 96 -24 0
key Shift+F
vworld 2 16 0 0
wait 2
press left
wait 1
vworld 2 16 0 8
wait 1
vworld 2 16 0 24
wait 1
release left
wait 1
key Return
wait 1
expect undo 7
expect bounds 0 -120 0 160 16 96
camera 0 40 35 600 80 -40 30
wait 3
shot a2-holes.png
quit
