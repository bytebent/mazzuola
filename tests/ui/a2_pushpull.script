# Alpha 2, v0.2.0: push/pull (ARCHITECTURE §6 Push/pull, agreed 2026-11-20).
# Views: 0 3D, 1 Top (x right, y up), 2 Front (x right, z up), 3 Right. Grid 8, snap on.
vworld 2 0 0 0
wheel -3
wait 2
addbox 0 0 0 64 48 32
expect faces 6
action edit.selectnone
key Shift+F
expect tool Push/pull

# ---- Front view: the top face is a line; drag it up 16 (grid steps). Release keeps it.
vworld 2 32 0 32
wait 2
press left
wait 1
vworld 2 32 0 40
wait 1
vworld 2 32 0 49
wait 1
release left
wait 1
expect armed 1
expect pushdist 16
expect bounds 0 0 0 64 48 48
expect faces 6
expect undo 1
# Typed: 24 instead; Return applies (one step). The sides stretched: still a box.
toolset pushpull distance 24
expect bounds 0 0 0 64 48 56
key Return
wait 1
expect armed 0
expect undo 2
expect faces 6
expect verts 8
expect selected 0

# ---- Esc drops a push
vworld 2 64 0 28
wait 2
press left
wait 1
vworld 2 80 0 28
wait 1
release left
wait 1
expect pushdist 16
expect bounds 0 0 0 80 48 56
key Esc
wait 1
expect armed 0
expect bounds 0 0 0 64 48 56
expect undo 2

# ---- Too far in: red, Return does nothing (the bottom pushed up past the top)
vworld 2 32 0 0
wait 2
press left
wait 1
vworld 2 32 0 40
wait 1
vworld 2 32 0 64
wait 1
release left
wait 1
expect armed 1
expect opvalid 0
wait 2
shot a2-push-too-far.png
key Return
expect armed 1
expect undo 2
key Esc
expect armed 0

# ---- Cmd+drag: new side faces even on a box
hold cmd
vworld 2 64 0 28
wait 2
press left
wait 1
letgo cmd
vworld 2 72 0 28
wait 1
vworld 2 80 0 28
wait 1
release left
wait 1
expect faces 10
expect verts 12
# Pressing another face applies the pending push first, then pushes that one
vworld 2 0 0 28
wait 2
press left
wait 1
expect undo 3
vworld 2 -8 0 28
wait 1
release left
wait 1
expect bounds -8 0 0 80 48 56
key Return
wait 1
expect undo 4

# ---- 3D view: any face; a flat rectangle pulled up becomes a solid
addquad 200 0 264 64 0
expect faces 11
camera 0 35 30 600 232 32 0
wait 2
vworld 0 232 32 0
wait 2
press left
wait 1
vworld 0 232 32 8
wait 1
vworld 0 232 32 16
wait 1
release left
wait 1
expect armed 1
toolset pushpull distance 32
key Return
wait 1
expect faces 16
expect undo 6
shot a2-pushpull.png
quit
